[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/BtnPauseAimMode" to="." method="_on_btn_aim_mode_pressed"]
[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/BtnPauseFps" to="." method="_on_btn_pause_fps_pressed"]
[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/PauseAudioRow/BtnPauseMusic" to="." method="_on_btn_pause_music_pressed"]
[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/PauseAudioRow/BtnPauseSfx" to="." method="_on_btn_pause_sfx_pressed"]
[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/BtnPauseRestart" to="." method="_on_btn_restart_pressed"]
[connection signal="pressed" from="PauseOverlay/PauseCard/PauseMargin/PauseVBox/BtnPauseMenu" to="." method="_on_btn_back_menu_pressed"]
[connection signal="pressed" from="MatchEndOverlay/EndCard/EndMargin/EndVBox/BtnPlayAgain" to="." method="_on_btn_restart_pressed"]
[connection signal="pressed" from="MatchEndOverlay/EndCard/EndMargin/EndVBox/BtnEndMenu" to="." method="_on_btn_back_menu_pressed"]
